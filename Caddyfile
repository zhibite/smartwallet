# Caddy 自动 HTTPS 配置
# 安装: cp Caddyfile /etc/caddy/Caddyfile && systemctl reload caddy
#
# 日志走 stdout -> systemd journal，避免 /var/log/caddy/smartwallet.log
# 的权限问题。查看:  journalctl -u caddy -f
#
# 想用文件日志？换成:
#     log {
#         output file /var/log/caddy/smartwallet.log {
#             roll_size 100MiB
#             roll_keep 5
#         }
#     }
# 然后:  sudo mkdir -p /var/log/caddy
#        sudo chown -R caddy:caddy /var/log/caddy
#        sudo touch /var/log/caddy/smartwallet.log
#        sudo chown caddy:caddy /var/log/caddy/smartwallet.log
#        sudo systemctl reload caddy

smartwallet.tokensee.com {
	encode gzip
	reverse_proxy localhost:3001
	log {
		output stdout
	}
}

# 健康检查端点（可选）—— 默认注释掉，因为要求 health 子域解析。
# 如果你打算用 health.smartwallet.tokensee.com 做 LB 健康检查，
# 在 DNS 加一条 A 记录指向 VPS，然后取消下面注释并 reload caddy。
#
# health.smartwallet.tokensee.com {
# 	respond "ok" 200
# }
