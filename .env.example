# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=

# --- Worker (Cron Expressions) ---
WORKER_CRON_TX_SYNC=*/30 * * * * *
WORKER_CRON_SNAPSHOT=*/5 * * * *
